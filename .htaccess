# Cinepulse Apache URL Rewrite Rules
<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Admin routes
    RewriteRule ^admin/dashboard/?$ public/admin/dashboard.php [L,QSA]
    RewriteRule ^admin/tracker/?$ public/admin/tracker.php [L,QSA]
    RewriteRule ^admin/scan-logs/?$ public/admin/tracker_scan_logs.php [L,QSA]
    RewriteRule ^admin/?$ public/admin/dashboard.php [L,QSA]

    # Legacy/shortcut admin aliases
    RewriteRule ^dashboard/?$ public/admin/dashboard.php [L,QSA]
    RewriteRule ^tracker/?$ public/admin/tracker.php [L,QSA]
    RewriteRule ^scan-logs/?$ public/admin/tracker_scan_logs.php [L,QSA]

    # Public consumer routes
    RewriteRule ^schedule/?$ public/index.php [L,QSA]
    RewriteRule ^movies/?$ public/movies.php [L,QSA]
    RewriteRule ^planner/?$ public/double-feature.php [L,QSA]
    RewriteRule ^watch-party/?$ public/watch-party.php [L,QSA]
    RewriteRule ^export-pdf/?$ public/export_pdf.php [L,QSA]
    RewriteRule ^api/?$ public/api.php [L,QSA]
</IfModule>
